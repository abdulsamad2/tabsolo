{
  "name": "tabsolo",
  "productName": "TabSolo",
  "version": "0.1.0-beta.2",
  "description": "Multi-session browser with a separate session and proxy per tab.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test test/*.test.js",
    "build:icon": "node scripts/build-icon.js",
    "dist:mac": "npm run build:icon && electron-builder --mac",
    "dist:win": "npm run build:icon && electron-builder --win",
    "dist": "npm run build:icon && electron-builder --mac --win",
    "release:win": "npm run build:icon && npm run release:prepare && node --env-file-if-exists=.env.local node_modules/electron-builder/cli.js --win --publish always && npm run release:finalize",
    "release:mac": "npm run build:icon && npm run release:prepare && node --env-file-if-exists=.env.local node_modules/electron-builder/cli.js --mac --publish always && npm run release:finalize",
    "release": "npm run build:icon && npm run release:prepare && node --env-file-if-exists=.env.local node_modules/electron-builder/cli.js --mac --publish always && node --env-file-if-exists=.env.local node_modules/electron-builder/cli.js --win --publish always && npm run release:finalize",
    "test:e2e": "node test/run-electron-tests.js",
    "release:prepare": "node --env-file-if-exists=.env.local scripts/release.js prepare",
    "release:finalize": "node --env-file-if-exists=.env.local scripts/release.js finalize"
  },
  "build": {
    "appId": "app.tabsolo.browser",
    "productName": "TabSolo",
    "generateUpdatesFilesForAllChannels": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "abdulsamad2",
        "repo": "tabsolo",
        "private": false,
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
